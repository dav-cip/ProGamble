ll id="lgt0" value="5 V (VBUS, from USB)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="1288" width="250" height="24" as="geometry"/></mxCell><mxCell id="lg1a" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="390" y="1300" width="1" height="1" as="geometry"/></mxCell><mxCell id="lg1b" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="1300" width="1" height="1" as="geometry"/></mxCell><mxCell id="lge1" value="" style="edgeStyle=none;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#ff8c00;strokeWidth=3;endArrow=none;endFill=1;endSize=7;startArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="lg1a" target="lg1b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgt1" value="3.3 V (3V3)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="1288" width="250" height="24" as="geometry"/></mxCell><mxCell id="lg2a" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="1300" width="1" height="1" as="geometry"/></mxCell><mxCell id="lg2b" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="780" y="1300" width="1" height="1" as="geometry"/></mxCell><mxCell id="lge2" value="" style="edgeStyle=none;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#222222;strokeWidth=3;endArrow=none;endFill=1;endSize=7;startArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="lg2a" target="lg2b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgt2" value="GND (common)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="1288" width="250" height="24" as="geometry"/></mxCell><mxCell id="lg3a" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1050" y="1300" width="1" height="1" as="geometry"/></mxCell><mxCell id="lg3b" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1110" y="1300" width="1" height="1" as="geometry"/></mxCell><mxCell id="lge3" value="" style="edgeStyle=none;rounded=0;html=1;jumpStyle=arc;jumpSize=10;strokeColor=#2ca02c;strokeWidth=3;endArrow=none;endFill=1;endSize=7;startArrow=none;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="lg3a" target="lg3b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgt3" value="signal wires (colour only to tell them apart)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="1288" width="250" height="24" as="geometry"/></mxCell><mxCell id="foot" value="• Never feed 5 V into a GPIO: every signal going into the board is 3.3 V (the PIR output is 3.3 V even when powered at 5 V).&#xa;• Grey dashed pins = not connected.   • Connect GND first and power last; keep the T_ (touch) wires off the rails.&#xa;• PWM outputs: buzzer (A3). Digital on/off output: status LED (A2). New components: ILI9341 screen and WS2812B ring." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="1326" width="1820" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>